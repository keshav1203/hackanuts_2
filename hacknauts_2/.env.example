# Copy to .env (never commit it). Used by docker compose and by local backend runs.
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGINS=http://localhost:5173
ENABLE_DEMO=true

# Groq API – get your key at console.groq.com
GROQ_API_KEY=
GROQ_CODE_MODEL=llama-3.3-70b-versatile
GROQ_PERFORMANCE_MODEL=llama-3.3-70b-versatile
GROQ_OPTIMIZATION_MODEL=llama-3.3-70b-versatile

# Alternative agent model aliases
# CODE_AGENT_MODEL=llama-3.3-70b-versatile
# PERFORMANCE_AGENT_MODEL=llama-3.3-70b-versatile
# OPTIMIZATION_AGENT_MODEL=llama-3.3-70b-versatile

GROQ_TIMEOUT=60
GROQ_MAX_RETRIES=3
GROQ_TEMPERATURE=0.2

# Where the browser reaches the API (baked into the frontend build)
VITE_API_URL=http://localhost:8000
